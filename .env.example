# =============================================================================
# PostgreSQL — production
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

# ── DNS (for application connection strings) ──────────────────
# Create an A record: db.yourdomain.com → this server's public IP
POSTGRES_HOST=db.yourdomain.com

# Published port. Default 5432:5432 (reachable via DNS from other hosts).
# Localhost only: POSTGRES_PORT_PUBLISH=127.0.0.1:5432:5432
POSTGRES_PORT_PUBLISH=5432:5432
