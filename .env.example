# =============================================================================
# PostgreSQL — production
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

# ── DNS (for application connection strings) ──────────────────
# Create an A record: db.yourdomain.com → this server's public IP
POSTGRES_HOST=db.yourdomain.com

# Port mapping. Default exposes 5432 for DNS-based remote access.
# Localhost only: POSTGRES_PORT_PUBLISH=127.0.0.1:5432:5432
POSTGRES_PORT_PUBLISH=5432:5432

# Container memory limit (adjust to your VPS; leave headroom for the OS).
POSTGRES_MEM_LIMIT=1536M

# Backup output directory (used by scripts/backup.sh).
BACKUP_DIR=./backups

# PostgreSQL log files (one file per day, kept on disk).
LOG_DIR=./logs/postgres
