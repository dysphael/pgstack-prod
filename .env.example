# =============================================================================
# pgstack-prod environment configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Never commit .env to version control. It contains secrets.
# =============================================================================

# PostgreSQL
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=appdb

# pgAdmin
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PGADMIN_DOMAIN=db.yourdomain.com

# Allowed IPs for pgAdmin access via Traefik middleware (comma-separated CIDR)
# Example: 203.0.113.10/32,198.51.100.0/24
# WARNING: Never use 0.0.0.0/0 in production
PGADMIN_ALLOWED_IPS=YOUR_IP/32

# =============================================================================
# Connection strings (replace PASSWORD with your POSTGRES_PASSWORD value)
# =============================================================================
#
# Via PgBouncer from another Docker container (same db_internal network):
#   postgresql://appuser:PASSWORD@pgbouncer:5432/appdb
#
# Via host loopback (from the VPS itself):
#   postgresql://appuser:PASSWORD@localhost:5432/appdb
#
# =============================================================================
