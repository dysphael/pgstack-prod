POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

# ADMIN ONLY — used for docker, backups, and scripts/databases/create-db.sh.
# Never put this user in application DATABASE_URL.

# DNS A record: db.yourdomain.com → server public IP
POSTGRES_HOST=db.yourdomain.com

# 5432:5432 = remote access via DNS | 127.0.0.1:5432:5432 = localhost only
POSTGRES_PORT_PUBLISH=5432:5432

POSTGRES_MEM_LIMIT=1536M
BACKUP_DIR=./backups
LOG_DIR=./logs/postgres
