# =============================================================================
# pgstack-prod environment configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Never commit .env to version control. It contains secrets.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=appdb

# ── pgAdmin ───────────────────────────────────────────────────
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PGADMIN_DOMAIN=db.yourdomain.com
# Allowed IPs for pgAdmin (comma-separated CIDR). Never use 0.0.0.0/0 in production.
PGADMIN_ALLOWED_IPS=YOUR_IP/32

# ── Netdata ───────────────────────────────────────────────────
NETDATA_DOMAIN=metrics.yourdomain.com
NETDATA_HOSTNAME=prod-server-01
NETDATA_ALLOWED_IPS=YOUR_IP/32
# Generate with: echo $(htpasswd -nb admin YOURPASSWORD) | sed -e s/\$/\$\$/g
# The $$ escaping is required by Docker Compose variable substitution.
NETDATA_BASIC_AUTH=admin:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Generating NETDATA_BASIC_AUTH
# =============================================================================
# Option 1 — use deploy.sh (no apache2-utils required):
#   ./deploy.sh htpasswd admin YOURPASSWORD
#
# Option 2 — manual (requires apache2-utils package):
#   echo $(htpasswd -nb admin YOURPASSWORD) | sed -e s/\$/\$\$/g
#
# Paste the output into NETDATA_BASIC_AUTH above.
# =============================================================================

# =============================================================================
# Connection strings (replace PASSWORD with your POSTGRES_PASSWORD value)
# =============================================================================
#
# Via PgBouncer from another Docker container (same db_internal network):
#   postgresql://appuser:PASSWORD@pgbouncer:5432/appdb
#
# Via host loopback (from the VPS itself):
#   postgresql://appuser:PASSWORD@localhost:5432/appdb
#
# =============================================================================
