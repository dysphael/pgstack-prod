# =============================================================================
# PostgreSQL — production
# =============================================================================
# Never commit .env to version control.
# =============================================================================

# Application user (not the internal "postgres" superuser role).
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Default database created on first boot.
# Use "postgres" (recommended) — it is the standard admin database.
# Create project databases later with CREATE DATABASE (see README).
POSTGRES_DB=postgres
